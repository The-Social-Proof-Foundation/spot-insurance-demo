# ---------------------------------------------------------------------------
# Copy to .env and adjust. The workspace .env is read by the backend (api/);
# web/.env holds the browser-side VITE_* variables.
# ---------------------------------------------------------------------------

PORT=8787

# Local MySo node endpoints (the `myso start ...` devnet)
MYSO_RPC_URL=http://127.0.0.1:9000
GRAPHQL_URL=http://127.0.0.1:9125/graphql
SOCIAL_API_URL=http://127.0.0.1:9126

# social_contracts Move package (short form, as used by the repo's E2E scripts)
SOCIAL_PACKAGE_ID=0x50c1
CLOCK_OBJECT_ID=0x6

# ---------------------------------------------------------------------------
# The simulated SPoT oracle / admin signing key.
#
# This account must hold SpotOracleAdminCap (market creation + resolution),
# SpotAdminCap (SpotConfig updates) and InsuranceAdminCap. On the MySo devnet it
# is the deployer address 0x2458950181e415250823d6ce1d55f2b3427826a111939e0d6d38e9a1397411d8,
# whose Ed25519 seed lives in ~/.myso/myso_config/myso.keystore.
#
# Accepted formats: 64-char hex seed, 0x-prefixed 66-char hex (flag||seed),
# base64 (32 or 33 bytes), or a bech32 `mysoprivkey…` string.
# Leave empty to run the UI read-only.
# ---------------------------------------------------------------------------
SPOT_ORACLE_PRIVATE_KEY=

# Only required when myso-social-server runs with SPOT_ORACLE_SYNC_SECRET set
# (it gates GET /spot/pending-posts).
# SPOT_ORACLE_SYNC_SECRET=

# Simulate transactions instead of submitting them.
SPOT_ORACLE_DRY_RUN=false

CORS_ORIGIN=*

# Demo pacing — keep the resolution window short so the whole
# approve -> bet -> insure -> resolve loop fits in a live session.
DEMO_RESOLUTION_WINDOW_MS=120000
DEMO_MAX_RESOLUTION_WINDOW_MS=600000

# Optional: pin object ids instead of discovering them from the chain.
# SPOT_CONFIG_ID=
# SPOT_REGISTRY_ID=
# SPOT_ADMIN_CAP_ID=
# SPOT_ORACLE_ADMIN_CAP_ID=
# INSURANCE_CONFIG_ID=
# INSURANCE_ROUTER_CONFIG_ID=
# INSURANCE_BACKSTOP_ID=
# INSURANCE_ADMIN_CAP_ID=
# PLATFORM_OBJECT_ID=
# ECOSYSTEM_TREASURY_ID=
